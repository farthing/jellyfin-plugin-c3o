# Settings for deploy.sh. Copy this file to .local/deploy.env (which git ignores) and edit it.
# Only C3O_HOST is required; the rest show their defaults.

# SSH destination of the machine you reach Jellyfin through.
C3O_HOST="root@jellyfin.lan"

# If Jellyfin runs inside a container on that machine, the command prefix that gets into it.
# Proxmox LXC:  C3O_EXEC="pct exec 101 --"
# Docker:       C3O_EXEC="docker exec -i jellyfin"
# Leave empty when C3O_HOST is the Jellyfin machine itself.
C3O_EXEC=""

# C3O_SSH="ssh"                              # e.g. /c/Windows/System32/OpenSSH/ssh.exe to use the Windows ssh-agent from Git Bash
# C3O_PLUGINS="/var/lib/jellyfin/plugins"    # Jellyfin's plugin folder (Docker images: /config/plugins)
# C3O_USER="jellyfin"                        # owner of the plugin files
# C3O_MEDIA="/mnt/|/media/"                  # regex for where media lives; used to see if someone is watching
# C3O_RESTART="systemctl restart jellyfin"   # how to restart Jellyfin
